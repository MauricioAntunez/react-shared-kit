{
  "name": "@uxr/react-shared-kit",
  "version": "2026.831.2",
  "description": "Small, app-agnostic React utilities shared across projects.",
  "license": "MIT",
  "author": "Mauricio Antúnez",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MauricioAntunez/react-shared-kit.git"
  },
  "homepage": "https://github.com/MauricioAntunez/react-shared-kit#readme",
  "bugs": {
    "url": "https://github.com/MauricioAntunez/react-shared-kit/issues"
  },
  "keywords": [
    "react",
    "keys",
    "list",
    "typescript",
    "utilities"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./images": {
      "source": "./src/image/index.ts",
      "types": "./dist/image/index.d.ts",
      "import": "./dist/image/index.js"
    },
    "./node": {
      "source": "./src/image/node/index.ts",
      "types": "./dist/image/node/index.d.ts",
      "import": "./dist/image/node/index.js"
    },
    "./check": {
      "source": "./src/image/check/index.ts",
      "types": "./dist/image/check/index.d.ts",
      "import": "./dist/image/check/index.js"
    },
    "./perf": {
      "source": "./src/perf/index.ts",
      "types": "./dist/perf/index.d.ts",
      "import": "./dist/perf/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/__fixtures__"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "release": "npm version \"$(node scripts/calver.mjs)\" && git push --follow-tags"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": ">=19",
    "sharp": ">=0.35 <1",
    "imagetools-core": ">=10 <11"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    },
    "imagetools-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "imagetools-core": "^10.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
